<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:aio="http://aio-upgrade/schema/1.0" id="Definitions_DollarQuoteSQLi" targetNamespace="http://example.org/dollar-quote-sqli" exporter="Camunda Modeler" exporterVersion="5.47.0">
  <bpmn:collaboration id="Collaboration_1tbwr8m">
    <bpmn:participant id="Participant_16s71wa" name="Dollar-Quote Bypass: A Novel Blind SQL Injection Technique Against PostgreSQL" processRef="Process_AttackChain" />
  </bpmn:collaboration>
  <bpmn:process id="Process_AttackChain" name="Dollar-Quote Bypass + Scalar Subquery Blind SQLi" isExecutable="false">
    <bpmn:startEvent id="Start_Recon" name="Identify PL/pgSQL search endpoint">
      <bpmn:outgoing>F_Start_Probe</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Probe" name="Send dollar-quote probe&#10;($_$test$_$ via filter input)">
      <bpmn:incoming>F_Start_Probe</bpmn:incoming>
      <bpmn:outgoing>F_Probe_GwBypass</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_Bypass" name="Regex filter bypassed?&#10;($ survives [&#39;&#39;;\-] strip)">
      <bpmn:incoming>F_Probe_GwBypass</bpmn:incoming>
      <bpmn:outgoing>F_GwBypass_NotVuln</bpmn:outgoing>
      <bpmn:outgoing>F_GwBypass_Oracle</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_NotVuln" name="Not exploitable&#10;($ stripped / parameterized)">
      <bpmn:incoming>F_GwBypass_NotVuln</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_Oracle" name="Confirm boolean oracle&#10;(SELECT 1) IS NOT NULL = 1">
      <bpmn:incoming>F_GwBypass_Oracle</bpmn:incoming>
      <bpmn:outgoing>F_Oracle_GwOracle</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_Oracle" name="Oracle observable?&#10;(count&#62;0 vs count=0)">
      <bpmn:incoming>F_Oracle_GwOracle</bpmn:incoming>
      <bpmn:outgoing>F_GwOracle_NoOracle</bpmn:outgoing>
      <bpmn:outgoing>F_GwOracle_Enum</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_NoOracle" name="Abort&#10;(TRUE and FALSE identical)">
      <bpmn:incoming>F_GwOracle_NoOracle</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_Extract" name="Extract value char-by-char&#10;substr()=CHAR, ASCII fallback for &#39; ; -">
      <bpmn:incoming>F_GwMore_Extract</bpmn:incoming>
      <bpmn:incoming>F_Enum_Extract</bpmn:incoming>
      <bpmn:outgoing>F_Extract_GwMore</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_More" name="More chars / rows?">
      <bpmn:incoming>F_Extract_GwMore</bpmn:incoming>
      <bpmn:outgoing>F_GwMore_Extract</bpmn:outgoing>
      <bpmn:outgoing>F_GwMore_Reconstruct</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Reconstruct" name="Reconstruct credentials &#38; secrets&#10;(password_hash, totp_secret, api_keys)">
      <bpmn:incoming>F_GwMore_Reconstruct</bpmn:incoming>
      <bpmn:outgoing>F_Reconstruct_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Exfil" name="Full secret exfiltration">
      <bpmn:incoming>F_Reconstruct_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_Start_Probe" sourceRef="Start_Recon" targetRef="Task_Probe" aio:animated="true" />
    <bpmn:sequenceFlow id="F_Probe_GwBypass" sourceRef="Task_Probe" targetRef="Gw_Bypass" aio:animated="true" />
    <bpmn:sequenceFlow id="F_GwBypass_NotVuln" name="No: $ stripped" sourceRef="Gw_Bypass" targetRef="End_NotVuln" />
    <bpmn:sequenceFlow id="F_GwBypass_Oracle" name="Yes: $_$ survives" sourceRef="Gw_Bypass" targetRef="Task_Oracle" aio:animated="true" />
    <bpmn:sequenceFlow id="F_Oracle_GwOracle" sourceRef="Task_Oracle" targetRef="Gw_Oracle" aio:animated="true" />
    <bpmn:sequenceFlow id="F_GwOracle_NoOracle" name="No" sourceRef="Gw_Oracle" targetRef="End_NoOracle" />
    <bpmn:sequenceFlow id="F_GwOracle_Enum" name="Yes" sourceRef="Gw_Oracle" targetRef="Sub_Enumerate" aio:animated="true" />
    <bpmn:sequenceFlow id="F_GwMore_Extract" name="Yes: next position / row" sourceRef="Gw_More" targetRef="Task_Extract" aio:animated="true" />
    <bpmn:sequenceFlow id="F_Extract_GwMore" sourceRef="Task_Extract" targetRef="Gw_More" aio:animated="true" />
    <bpmn:sequenceFlow id="F_GwMore_Reconstruct" name="No: complete" sourceRef="Gw_More" targetRef="Task_Reconstruct" aio:animated="true" />
    <bpmn:sequenceFlow id="F_Reconstruct_End" sourceRef="Task_Reconstruct" targetRef="End_Exfil" aio:animated="true" />
    <bpmn:subProcess id="Sub_Enumerate" name="Zero-knowledge enumeration (information_schema)">
      <bpmn:incoming>F_GwOracle_Enum</bpmn:incoming>
      <bpmn:outgoing>F_Enum_Extract</bpmn:outgoing>
      <bpmn:endEvent id="Sub_End" name="Schema mapped">
        <bpmn:incoming>SF_Rows_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:task id="Sub_Rows" name="Discover rows&#10;(usernames, services)">
        <bpmn:incoming>SF_Columns_Rows</bpmn:incoming>
        <bpmn:outgoing>SF_Rows_End</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="SF_Rows_End" sourceRef="Sub_Rows" targetRef="Sub_End" aio:animated="true" />
      <bpmn:task id="Sub_Columns" name="Discover columns&#10;information_schema.columns">
        <bpmn:incoming>SF_Tables_Columns</bpmn:incoming>
        <bpmn:outgoing>SF_Columns_Rows</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="SF_Columns_Rows" sourceRef="Sub_Columns" targetRef="Sub_Rows" aio:animated="true" />
      <bpmn:task id="Sub_Tables" name="Discover tables&#10;information_schema.tables">
        <bpmn:incoming>SF_Schemas_Tables</bpmn:incoming>
        <bpmn:outgoing>SF_Tables_Columns</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="SF_Tables_Columns" sourceRef="Sub_Tables" targetRef="Sub_Columns" aio:animated="true" />
      <bpmn:task id="Sub_Schemas" name="Discover schemas&#10;information_schema.schemata">
        <bpmn:incoming>SF_Start_Schemas</bpmn:incoming>
        <bpmn:outgoing>SF_Schemas_Tables</bpmn:outgoing>
      </bpmn:task>
      <bpmn:sequenceFlow id="SF_Schemas_Tables" sourceRef="Sub_Schemas" targetRef="Sub_Tables" aio:animated="true" />
      <bpmn:startEvent id="Sub_Start" name="No prior knowledge">
        <bpmn:outgoing>SF_Start_Schemas</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="SF_Start_Schemas" sourceRef="Sub_Start" targetRef="Sub_Schemas" aio:animated="true" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="F_Enum_Extract" sourceRef="Sub_Enumerate" targetRef="Task_Extract" aio:animated="true" />
  </bpmn:process>
